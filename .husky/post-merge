set -e  # Exit on error

# Validate script exists first
if [ ! -x "scripts/update_readme_files.sh" ]; then
    echo "Warning: scripts/update_readme_files.sh not found or not executable" >&2
    exit 0
fi

# Run the script that updates the README files.
if ! scripts/update_readme_files.sh; then
    echo "Warning: README update script failed" >&2
    exit 0  # Don't block the merge
fi

git add README.md packages/*/README.md

# Create the commit (check if anything actually staged)
if git diff --cached --quiet; then
    echo "No changes to commit after staging" >&2
else
    # Get destination branch (current branch or commit hash if detached)
    DEST_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD)
    SOURCE_BRANCH=""

    # Method 1: Parse reflog (most reliable for post-merge)
    # Portable whitespace trimming without xargs
    SOURCE_BRANCH=$(git reflog -n 1 | sed -n 's/.*merge \([^:]*\):.*/\1/p' | head -1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

    # Method 2: Check ORIG_HEAD (alternative approach)
    if [ -z "$SOURCE_BRANCH" ] && [ -f .git/ORIG_HEAD ]; then
        ORIG_HASH=$(cat .git/ORIG_HEAD)
        # Prefer local branches first, then remote branches
        # Use '^\* ' to match the current branch marker (asterisk at start of line followed by space)
        SOURCE_BRANCH=$(git branch --contains "$ORIG_HASH" 2>/dev/null | grep -v '^\* ' | head -1 | sed 's/^[* ]*//')
        if [ -z "$SOURCE_BRANCH" ]; then
            # Fall back to remote branches
            SOURCE_BRANCH=$(git branch -r --contains "$ORIG_HASH" 2>/dev/null | grep -v "HEAD" | head -1 | sed 's/^[* ]*//; s/remotes\/origin\///')
        fi
    fi

    # Sanitize branch names for commit message (remove problematic characters)
    SOURCE_BRANCH=$(echo "$SOURCE_BRANCH" | tr -d '\n\r\t' | sed 's/["$`\\]//g')
    DEST_BRANCH=$(echo "$DEST_BRANCH" | tr -d '\n\r\t' | sed 's/["$`\\]//g')

    # Build commit message
    if [ -n "$SOURCE_BRANCH" ] && [ "$SOURCE_BRANCH" != "$DEST_BRANCH" ]; then
        COMMIT_MSG="docs: update READMEs ($SOURCE_BRANCH → $DEST_BRANCH)"
    else
        COMMIT_MSG="docs: update READMEs (merge into $DEST_BRANCH)"
    fi

    git commit -m "$COMMIT_MSG"
    echo "✓ README files updated and committed"
fi